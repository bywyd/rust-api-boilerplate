APP_NAME=RustBoilerplateAPI
# Application environment: development | production
APP_ENV=development

# Database overrides config/default.yaml database.url
DATABASE__URL=mysql://root:password@localhost:3306/app

# Redis set cache.redis.enabled=true in config or via env to activate
CACHE__REDIS__ENABLED=false
CACHE__REDIS__URL=redis://localhost:6379

AUTH__JWT_SECRET=change_me_in_production_use_a_long_random_string
AUTH__JWT_EXPIRY_HOURS=24

# Server
SERVER__HOST=127.0.0.1
SERVER__PORT=8080

# Rate limiting (actix-governor)
# Toggle the global kill-switch. Individual rules live in config/default.yaml
# under rate_limit.rules and are referenced by name in router.rs.
RATE_LIMIT__ENABLED=true
# Override a specific rule via env vars (double-underscore = nesting separator):
# RATE_LIMIT__RULES__DEFAULT__SECONDS_PER_REQUEST=1
# RATE_LIMIT__RULES__DEFAULT__BURST_SIZE=60
# RATE_LIMIT__RULES__AUTH__SECONDS_PER_REQUEST=20
# RATE_LIMIT__RULES__AUTH__BURST_SIZE=5

# Email (SMTP via lettre) — set ENABLED=true and fill credentials to activate
EMAIL__ENABLED=false
EMAIL__SMTP_HOST=smtp.example.com
EMAIL__SMTP_PORT=587
EMAIL__SMTP_USERNAME=
EMAIL__SMTP_PASSWORD=
EMAIL__FROM_ADDRESS=noreply@example.com
EMAIL__FROM_NAME=App
EMAIL__TLS_MODE=starttls
